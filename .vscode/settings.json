{
  "python.defaultInterpreterPath": "${workspaceFolder}/backend_python/venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/backend_python/venv/Lib/site-packages"
  ],
  "pyrefly.enable": false,
  "css.validate": false,
  "less.validate": false,
  "scss.validate": false,
  "css.lint.unknownAtRules": "ignore",
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.exclude": {
    "**/.vscode": true
  }
}
